
function removeFalsyValues(arr) {

  let result = [];

  for (let i = 0; i < arr.length; i++) {

    if (arr[i]) {
      result[result.length] = arr[i];
    }
  }

  return result;
}

let arr = [
  0,
  1,
  false,
  2,
  "",
  3,
  null,
  4,
  undefined
];

console.log(removeFalsyValues(arr));
// [1, 2, 3, 4]









