function Dupalicate(arr){
    res = []
    for(let i=0;i<arr.length;i++){
       isDupliacte =false;
        for(let j=i+1;j<arr.length;j++){
            if(arr[i] == arr[j]){
                isDupliacte = true;
                if(!res.includes(arr[i])){
          res.push(arr[i]);
        } 
                break;
            }
        }
    }
    return res;
}

