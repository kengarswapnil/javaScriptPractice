function commonElement(arr1, arr2){
   let res = [];
   for(let i = 0; i < arr1.length; i++){
      for(let j = 0; j < arr2.length; j++){ 
          if(arr1[i] === arr2[j]){
              res.push(arr1[i]); 
            }
        }
   }
   return res;
}
console.log(commonElement([1, 2, 3, 4], [1, 2,4])); 
